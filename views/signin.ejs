<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign in | The Blog Squad</title>
    <link rel="stylesheet" href="/stylesheet.css">
</head>
<body class="auth-page">
    <main class="auth-card">
        <a class="brand-link" href="/">The Blog Squad</a>
        <p class="eyebrow">Welcome back</p>
        <h1>Sign in</h1>
        <p>Pick up where you left off.</p>
        <% if (error) { %><p class="form-message" role="alert"><%= error %></p><% } %>
        <form action="/signin" method="POST">
            <label for="user_id">User ID</label>
            <input id="user_id" name="user_id" type="text" maxlength="255" value="<%= userId %>" autocomplete="username" required>
            <label for="password">Password</label>
            <input id="password" name="password" type="password" maxlength="255" autocomplete="current-password" required>
            <button type="submit">Sign in</button>
        </form>
        <p class="auth-switch">New here? <a href="/signup">Create an account</a></p>
        <details class="demo-logins">
            <summary>Demo accounts</summary>
            <p>john / Maneater11!</p>
            <p>glenn / RhinestoneCowboy13!</p>
            <p>ark / SheStoleMyHeart17!</p>
            <p>stephen / UntilIFoundYou23!</p>
            <p>edward / Home29!</p>
        </details>
    </main>
</body>
</html>
